rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /spbjContracts/{spbjId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(spbjId);
    }

    match /boqItems/{boqId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(boqId);
    }

    match /mandors/{mandorId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(mandorId);
    }

    match /companyVehicles/{vehicleId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(vehicleId);
    }

    match /leaseVehicles/{leaseId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(leaseId);
    }

    match /emergencyWorks/{emergencyId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(emergencyId);
    }

    match /bopItems/{bopId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(bopId);
    }

    match /materialBongkar/{bongkarId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(bongkarId);
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(userId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
